# Native Kujo benchmark harness for ContentGraph.
func fail(message) {
    print("ContentGraph benchmark: " + message)
    exit(1)
}

node_count := 1000
argv := args()
i := 0
loop {
    if i >= len(argv) { break }
    if argv[i] == "--nodes" && i + 1 < len(argv) {
        node_count = to_int(argv[i + 1])
        i = i + 2
    } else {
        fail("usage: contentgraph-benchmark [--nodes COUNT]")
    }
}
if node_count < 1 || node_count > 20000 { fail("--nodes must be between 1 and 20000") }

root := "/tmp/contentgraph-benchmark-" + uuid_v4()
source := root + "/source.csv"
out := root + "/run"
create_dir(root)
write_file(source,"id,title,url,content\n")

i = 0
loop {
    if i >= node_count { break }
    body := to_string(i) + ",Page " + to_string(i) + ",https://example.com/page-" + to_string(i) + ",shared highfrequency topic corpus\n"
    append_file(source, body)
    i = i + 1
}

started := performance_now()
build_command := ["./contentgraph", "build", "--csv", source, "--out", out, "--max-nodes", to_string(node_count), "--max-term-document-frequency-ratio", "0.05", "--deterministic", "--json"]
platform := trim(spawn_process(["uname","-s"],{"timeout_ms":5000,"max_output_bytes":4096}).stdout)
timing_path := root + "/resource-usage.txt"
timed_command := build_command
if path_is_file("/usr/bin/time") {
    if platform=="Darwin" { timed_command=concat(["/usr/bin/time","-l","-o",timing_path],build_command) }
    else if platform=="Linux" { timed_command=concat(["/usr/bin/time","-v","-o",timing_path],build_command) }
}
result := spawn_process(timed_command, {"timeout_ms": 1800000, "max_output_bytes":65536})
elapsed := (performance_now() - started) / 1000.0
if result.exitcode != 0 { fail(trim(result.stderr + "\n" + result.stdout)) }

peak_rss_bytes := null
if path_is_file(timing_path) {
    for line in read_lines(timing_path) {
        if contains(lower(line),"maximum resident set size")>0 {
            digits:=regex_replace(line,"[^0-9]","")
            if digits!="" { peak_rss_bytes=to_int(digits); if platform=="Linux" { peak_rss_bytes=peak_rss_bytes*1024 } }
        }
    }
}

artifact_names := ["graph.json", "nodes.jsonl", "edges.jsonl", "clusters.json", "overlaps.json", "orphan-candidates.json", "link-opportunities.json", "analysis.json", "metadata.json", "report.md", "vector-cache.jsonl", "adapter-cache.jsonl", "manifest.json"]
output_bytes := 0
for name in artifact_names { output_bytes = output_bytes + file_size(out + "/" + name) }
build_result := parse_json(result.stdout)
print(to_json({"schema":"contentgraph.benchmark/v1", "nodes":node_count, "seconds":elapsed, "peak_rss_bytes":peak_rss_bytes, "output_bytes":output_bytes, "candidate_pairs":build_result["usage"]["candidate_pairs"], "retained_similarity_pairs":build_result["usage"]["retained_similarity_pairs"], "skipped_high_frequency_terms":build_result["usage"]["skipped_high_frequency_terms"], "harness":"kujo", "engine":"kujo"}))

# Remove only the UUID-scoped temporary tree created above.
for name in artifact_names { delete_file(out + "/" + name) }
os_rmdir(out)
delete_file(source)
if path_is_file(timing_path) { delete_file(timing_path) }
os_rmdir(root)
