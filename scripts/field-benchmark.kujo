# Reproducible, offline field benchmark runner for consented public corpora.
from src.ingest import source_files

func fail(message){eprint("ContentGraph field benchmark: "+message);exit(1)}
func insert_number(values,value){result:=[];inserted:=false;for current in values{if !inserted&&value<current{result=push(result,value);inserted=true};result=push(result,current)};if !inserted{result=push(result,value)};return result}
func median(values){ordered:=[];for value in values{ordered=insert_number(ordered,value)};middle:=to_int(len(ordered)/2);if len(ordered)%2==1{return ordered[middle]};return (ordered[middle-1]+ordered[middle])/2}
func variance(values){sum:=0.0;for value in values{sum=sum+value};mean:=sum/max(1,len(values));total:=0.0;for value in values{delta:=value-mean;total=total+delta*delta};return total/max(1,len(values))}

manifest_path:="";out_path:="";repeats:=3;argv:=args();i:=0
loop{if i>=len(argv){break};if argv[i]=="--manifest"&&i+1<len(argv){manifest_path=argv[i+1];i=i+2}else if argv[i]=="--out"&&i+1<len(argv){out_path=argv[i+1];i=i+2}else if argv[i]=="--repeats"&&i+1<len(argv){repeats=to_int(argv[i+1]);i=i+2}else{fail("usage: field-benchmark.kujo --manifest FILE --out FILE [--repeats N]")}}
if manifest_path==""||out_path==""||repeats<2||repeats>10{fail("manifest/out are required and repeats must be 2..10")}
manifest:=parse_json(read_file(manifest_path));if manifest["schema"]!="contentgraph.field-corpora/v1"{fail("unsupported manifest")}
platform:=trim(spawn_process(["uname","-s"],{"timeout_ms":5000,"max_output_bytes":4096}).stdout);hardware:=manifest["hardware"]
profiles:=[]
for corpus in manifest["corpora"]{
    root:=env(corpus["path_env"]);if !path_is_dir(root){fail("corpus directory not found; set "+corpus["path_env"])};files:=source_files(root,"");page_count:=len(files);if page_count<5000||page_count>20000{fail(corpus["name"]+" must contain 5000..20000 accepted pages; found "+to_string(page_count))}
    seconds:=[];rss_values:=[];candidate_pairs:=[];output_bytes:=[]
    for repetition in range(0,repeats){temp:=path_join("/tmp","contentgraph-field-"+uuid_v4());run:=path_join(temp,"run");timing:=path_join(temp,"time.txt");create_dir(temp);command:=["./contentgraph","build","--source",root,"--out",run,"--max-nodes","20000","--max-term-document-frequency-ratio",to_string(manifest["settings"]["max_term_document_frequency_ratio"]),"--max-candidate-pairs",to_string(manifest["settings"]["max_candidate_pairs"]),"--deterministic","--json"];timed:=command;if path_is_file("/usr/bin/time"){if platform=="Darwin"{timed=concat(["/usr/bin/time","-l","-o",timing],command)}else if platform=="Linux"{timed=concat(["/usr/bin/time","-v","-o",timing],command)}};started:=performance_now();result:=spawn_process(timed,{"timeout_ms":3600000,"max_output_bytes":65536});elapsed:=(performance_now()-started)/1000.0;if result.exitcode!=0{fail(corpus["name"]+" repetition "+to_string(repetition+1)+": "+result.stderr)};rss:=null;if path_is_file(timing){for line in read_lines(timing){if contains(lower(line),"maximum resident set size")>0{digits:=regex_replace(line,"[^0-9]","");if digits!=""{rss=to_int(digits);if platform=="Linux"{rss=rss*1024}}}}};build:=parse_json(result.stdout);seconds=push(seconds,elapsed);rss_values=push(rss_values,rss);candidate_pairs=push(candidate_pairs,build["usage"]["candidate_pairs"]);output_bytes=push(output_bytes,build["output_bytes"]);cleanup:=spawn_process(["find",temp,"-depth","-delete"],{"timeout_ms":30000,"max_output_bytes":4096});if cleanup.exitcode!=0{fail("temporary cleanup failed")}}
    profiles=push(profiles,{"name":corpus["name"],"source_url":corpus["source_url"],"source_commit":corpus["source_commit"],"license":corpus["license"],"consent_basis":corpus["consent_basis"],"redaction":corpus["redaction"],"shape":{"accepted_pages":page_count,"sample_strategy":corpus["sample_strategy"]},"repeats":repeats,"seconds":{"samples":seconds,"median":median(seconds),"variance":variance(seconds)},"peak_rss_bytes":{"samples":rss_values,"median":median(rss_values),"variance":variance(rss_values)},"candidate_pairs":{"samples":candidate_pairs,"median":median(candidate_pairs)},"output_bytes":{"samples":output_bytes,"median":median(output_bytes)}})
}
report:={"schema":"contentgraph.field-benchmark/v1","classification":"field-public-consented-redacted","synthetic_results_included":false,"engine":"kujo","contentgraph_version":trim(read_file("VERSION")),"hardware":hardware,"settings":manifest["settings"],"profiles":profiles,"regression_thresholds":manifest["regression_thresholds"]}
create_dir(dirname(out_path));write_file(out_path,to_json_pretty(report)+"\n",true);print(to_json({"schema":"contentgraph.field-benchmark-run/v1","out":out_path,"profiles":len(profiles),"repeats":repeats}))
