# Acquire the pinned public MDN revision and prepare the documented field samples.
from src.ingest import source_files
out:="";source:="";argv:=args();i:=0;loop{if i>=len(argv){break};if argv[i]=="--out"&&i+1<len(argv){out=argv[i+1];i=i+2}else if argv[i]=="--source"&&i+1<len(argv){source=argv[i+1];i=i+2}else{eprint("usage: prepare-field-corpora.kujo --out DIR [--source PINNED_CHECKOUT]");exit(1)}};if out==""{eprint("--out is required");exit(1)}
if path_exists(out){eprint("ContentGraph field preparation: output already exists: "+out);exit(1)};create_dir(out)
upstream:=source;commit:="8a10694edf44bde124fa8f18af65651855f632dc"
if upstream==""{upstream=path_join(out,"mdn-upstream");clone:=spawn_process(["git","clone","--depth","1","https://github.com/mdn/content.git",upstream],{"timeout_ms":1800000,"max_output_bytes":65536});if clone.exitcode!=0{eprint(clone.stderr);exit(1)};fetch:=spawn_process(["git","-C",upstream,"fetch","--depth","1","origin",commit],{"timeout_ms":1800000,"max_output_bytes":65536});if fetch.exitcode!=0{eprint(fetch.stderr);exit(1)};checkout:=spawn_process(["git","-C",upstream,"checkout","--detach",commit],{"timeout_ms":300000,"max_output_bytes":65536});if checkout.exitcode!=0{eprint(checkout.stderr);exit(1)}}
actual:=trim(spawn_process(["git","-C",upstream,"rev-parse","HEAD"],{"timeout_ms":5000,"max_output_bytes":4096}).stdout);if actual!=commit{eprint("Pinned MDN commit changed; expected "+commit+" but clone resolved "+actual);exit(1)}
api:=source_files(path_join(upstream,"files/en-us/web/api"),"files/en-us/web/api");non_api:=[];en_us:=path_join(upstream,"files/en-us")
for name in sort(list_dir(en_us)){path:=path_join(en_us,name);if name=="web"{for web_name in sort(list_dir(path)){if web_name!="api"{web_path:=path_join(path,web_name);if path_is_dir(web_path){non_api=concat(non_api,source_files(web_path,"files/en-us/web/"+web_name))}}}}else if path_is_dir(path){non_api=concat(non_api,source_files(path,"files/en-us/"+name))}}
filtered_api:=[];for item in api{if file_size(item["path"])<=5242880{filtered_api=push(filtered_api,item)}};api=filtered_api;filtered_non_api:=[];for item in non_api{if file_size(item["path"])<=5242880{filtered_non_api=push(filtered_non_api,item)}};non_api=filtered_non_api
if len(api)<5000||len(non_api)<5000{eprint("Pinned corpus no longer exposes the documented sample size");exit(1)}
func redact_public_text(text){value:=regex_replace(text,"(?im)^\\s*(url|canonical):.*$","");value=regex_replace(value,"(?i)https?://[^\\s]+","[redacted-url]");value=regex_replace(value,"(?i)[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}","[redacted-email]");return substring(value,0,min(512,len(value)))}
func copy_sample(items,destination,limit){create_dir(destination);for item in slice(items,0,limit){target:=path_join(destination,item["relative"]);create_dir(dirname(target));write_file(target,redact_public_text(read_file_lossy(item["path"])))}}
copy_sample(api,path_join(out,"mdn-api"),5000);copy_sample(non_api,path_join(out,"mdn-non-api"),5000)
mixed:=concat(slice(api,0,2500),slice(non_api,0,2500));copy_sample(mixed,path_join(out,"mdn-mixed"),5000)
print(to_json({"schema":"contentgraph.field-corpora-preparation/v1","source_commit":actual,"api":5000,"non_api":5000,"mixed":5000,"environment":{"CONTENTGRAPH_FIELD_MDN_API":path_join(out,"mdn-api"),"CONTENTGRAPH_FIELD_MDN_NON_API":path_join(out,"mdn-non-api"),"CONTENTGRAPH_FIELD_MDN_MIXED":path_join(out,"mdn-mixed")}}))
