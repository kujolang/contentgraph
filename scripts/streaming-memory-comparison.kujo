# Compare the 0.2.1 publisher with the qualified 0.3 field result on one pinned corpus.
func fail(message){eprint("ContentGraph streaming comparison: "+message);exit(1)}
func median(values){ordered:=sort(values);middle:=to_int(len(ordered)/2);if len(ordered)%2==1{return ordered[middle]};return (ordered[middle-1]+ordered[middle])/2.0}
baseline_launcher:="";baseline_results:="";corpus:="";field_results:="";out:="";repeats:=3;argv:=args();i:=0
loop{if i>=len(argv){break};if argv[i]=="--baseline-launcher"&&i+1<len(argv){baseline_launcher=argv[i+1];i=i+2}else if argv[i]=="--baseline-results"&&i+1<len(argv){baseline_results=argv[i+1];i=i+2}else if argv[i]=="--corpus"&&i+1<len(argv){corpus=argv[i+1];i=i+2}else if argv[i]=="--field-results"&&i+1<len(argv){field_results=argv[i+1];i=i+2}else if argv[i]=="--out"&&i+1<len(argv){out=argv[i+1];i=i+2}else if argv[i]=="--repeats"&&i+1<len(argv){repeats=to_int(argv[i+1]);i=i+2}else{fail("usage: streaming-memory-comparison.kujo (--baseline-launcher FILE --corpus DIR | --baseline-results FILE) --field-results FILE --out FILE [--repeats N]")}}
if !path_is_file(field_results)||out==""{fail("field results and output are required")};if baseline_results==""&&(!path_is_file(baseline_launcher)||!path_is_dir(corpus)){fail("baseline launcher and corpus are required when baseline results are not reused")};if baseline_results!=""&&!path_is_file(baseline_results){fail("baseline results do not exist")};if repeats<3||repeats>10{fail("--repeats must be 3..10")}
field:=parse_json(read_file(field_results));if field["schema"]!="contentgraph.field-benchmark/v1"||field["settings"]["max_term_document_frequency_ratio"]!=0.0{fail("field result settings do not match the comparison")}
candidate:=null;for profile in field["profiles"]{if profile["name"]=="mdn-web-api-5000"{candidate=profile}};if candidate==null{fail("mdn-web-api-5000 field profile is missing")}
platform:=trim(spawn_process(["uname","-s"],{"timeout_ms":5000,"max_output_bytes":4096}).stdout);rss_values:=[];seconds:=[];output_bytes:=[];candidate_pairs:=[]
if baseline_results!=""{prior:=parse_json(read_file(baseline_results));if prior["schema"]!="contentgraph.streaming-memory-comparison/v1"||prior["source_commit"]!="8a10694edf44bde124fa8f18af65651855f632dc"||prior["settings"]!=field["settings"]{fail("reused baseline provenance or settings do not match")};rss_values=prior["baseline_0_2_1"]["peak_rss_bytes"]["samples"];seconds=prior["baseline_0_2_1"]["seconds"]["samples"];output_bytes=prior["baseline_0_2_1"]["output_bytes"]["samples"];candidate_pairs=prior["baseline_0_2_1"]["candidate_pairs"]["samples"];repeats=len(rss_values)}else{for repetition in range(0,repeats){temp:=path_join("/tmp","contentgraph-streaming-baseline-"+uuid_v4());run_path:=path_join(temp,"run");timing_path:=path_join(temp,"time.txt");create_dir(temp);command:=[baseline_launcher,"build","--source",corpus,"--out",run_path,"--max-nodes","20000","--max-term-document-frequency-ratio","0.0","--max-candidate-pairs","2000000","--deterministic","--json"];timed:=command;if path_is_file("/usr/bin/time"){if platform=="Darwin"{timed=concat(["/usr/bin/time","-l","-o",timing_path],command)}else if platform=="Linux"{timed=concat(["/usr/bin/time","-v","-o",timing_path],command)}};started:=performance_now();result:=spawn_process(timed,{"timeout_ms":3600000,"max_output_bytes":8388608});elapsed:=(performance_now()-started)/1000.0;if result.exitcode!=0{fail("baseline repetition "+to_string(repetition+1)+": "+result.stderr)};rss:=null;if path_is_file(timing_path){for line in read_lines(timing_path){if contains(lower(line),"maximum resident set size")>0{digits:=regex_replace(line,"[^0-9]","");if digits!=""{rss=to_int(digits);if platform=="Linux"{rss=rss*1024}}}}};if rss==null{fail("peak RSS was unavailable")};build:=parse_json(result.stdout);rss_values=push(rss_values,rss);seconds=push(seconds,elapsed);output_bytes=push(output_bytes,build["output_bytes"]);candidate_pairs=push(candidate_pairs,build["usage"]["candidate_pairs"]);cleanup:=spawn_process(["find",temp,"-depth","-delete"],{"timeout_ms":30000,"max_output_bytes":4096});if cleanup.exitcode!=0{fail("temporary cleanup failed")}}}
baseline_rss:=median(rss_values);candidate_rss:=candidate["peak_rss_bytes"]["median"];reduction:=((to_float(baseline_rss)-to_float(candidate_rss))/to_float(baseline_rss))*100.0;material:=reduction>=5.0
report:={"schema":"contentgraph.streaming-memory-comparison/v1","classification":"field-public-consented-redacted","corpus":"mdn-web-api-5000","source_commit":"8a10694edf44bde124fa8f18af65651855f632dc","settings":field["settings"],"hardware":field["hardware"],"baseline_0_2_1":{"repeats":repeats,"seconds":{"samples":seconds,"median":median(seconds)},"peak_rss_bytes":{"samples":rss_values,"median":baseline_rss},"output_bytes":{"samples":output_bytes,"median":median(output_bytes)},"candidate_pairs":{"samples":candidate_pairs,"median":median(candidate_pairs)}},"candidate_0_3_0":{"source":"benchmarks/field-results-0.3.json#mdn-web-api-5000","repeats":len(candidate["peak_rss_bytes"]["samples"]),"seconds":candidate["seconds"],"peak_rss_bytes":candidate["peak_rss_bytes"],"output_bytes":candidate["output_bytes"],"candidate_pairs":candidate["candidate_pairs"]},"peak_rss_reduction_percent":reduction,"material_reduction_threshold_percent":5.0,"material_reduction_passed":material}
create_dir(dirname(out));write_file(out,to_json_pretty(report)+"\n",true);if !material{fail("median peak RSS reduction "+to_string(reduction)+"% is below 5%")};print(to_json({"schema":"contentgraph.streaming-memory-comparison-run/v1","out":out,"peak_rss_reduction_percent":reduction,"material_reduction_passed":material}))
