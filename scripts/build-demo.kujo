# Generate the deterministic, offline ContentGraph demonstration.
func escape_html(value) {
    text:=replace_str(to_string(value),"&","&amp;");text=replace_str(text,"<","&lt;");text=replace_str(text,">","&gt;");text=replace_str(text,"\"","&quot;");return text
}
func read_jsonl(path){values:=[];for line in read_lines(path){if trim(line)!=""{values=push(values,parse_json(line))}};return values}

out:="demo/index.html";argv:=args();if len(argv)==2&&argv[0]=="--out"{out=argv[1]}else if len(argv)>0{eprint("usage: build-demo.kujo [--out PATH]");exit(1)}
run:="fixtures/golden/run";nodes:=read_jsonl(path_join(run,"nodes.jsonl"));analysis:=parse_json(read_file(path_join(run,"analysis.json")));clusters:=parse_json(read_file(path_join(run,"clusters.json")))["clusters"]
cards:=""
for node in nodes { terms:=join(node["topic_signals"],", ");cards=cards+"<article data-search=\""+escape_html(lower(node["title"]+" "+terms))+"\"><h2>"+escape_html(node["title"])+"</h2><p><strong>Cluster:</strong> "+escape_html(node["cluster"])+"</p><p><strong>Measured terms:</strong> "+escape_html(terms)+"</p><p><a href=\"../fixtures/golden/run/nodes.jsonl\">Node evidence</a> · <a href=\"../src/engine.kujo\">Kujo engine source</a></p></article>" }
summary:="<li>Nodes: "+to_string(len(nodes))+" — <a href=\"../fixtures/golden/run/nodes.jsonl\">evidence</a></li><li>Clusters: "+to_string(len(clusters))+" — <a href=\"../fixtures/golden/run/clusters.json\">evidence</a></li><li>Components: "+to_string(analysis["summary"]["component_count"])+" — <a href=\"../fixtures/golden/run/analysis.json\">evidence</a></li>"
html:="<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'\"><title>ContentGraph deterministic demo</title><style>:root{color-scheme:light dark;font:16px system-ui}body{max-width:72rem;margin:auto;padding:2rem}input{width:100%;padding:.8rem;font:inherit}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1rem;margin-top:1rem}article{border:1px solid #888;border-radius:.5rem;padding:1rem}a{color:#1683d8}code{font-size:.9em}</style></head><body><h1>ContentGraph deterministic demo</h1><p>This static, offline view is generated by <a href=\"../scripts/build-demo.kujo\">Kujo</a>. Every conclusion links to its immutable public-corpus artifact.</p><ul>"+summary+"</ul><label for=\"filter\">Filter nodes</label><input id=\"filter\" type=\"search\" placeholder=\"title or measured term\"><main>"+cards+"</main><script>const q=document.querySelector('#filter'),cards=[...document.querySelectorAll('article')];q.addEventListener('input',()=>{const v=q.value.toLowerCase();for(const c of cards)c.hidden=!c.dataset.search.includes(v)})</script></body></html>"
create_dir(dirname(out));write_file(out,html+"\n",true);print(to_json({"schema":"contentgraph.demo-build/v1","out":out,"nodes":len(nodes),"clusters":len(clusters)}))
