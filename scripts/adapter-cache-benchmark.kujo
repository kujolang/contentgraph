# Deterministic-fixture cold/partial-warm adapter cache benchmark.
func insert_number(values,value){result:=[];inserted:=false;for current in values{if !inserted&&value<current{result=push(result,value);inserted=true};result=push(result,current)};if !inserted{result=push(result,value)};return result}
func median(values){ordered:=[];for value in values{ordered=insert_number(ordered,value)};middle:=to_int(len(ordered)/2);if len(ordered)%2==1{return ordered[middle]};return (ordered[middle-1]+ordered[middle])/2}
repeats:=5;argv:=args();if len(argv)==2&&argv[0]=="--repeats"{repeats=to_int(argv[1])}else if len(argv)>0{eprint("usage: adapter-cache-benchmark.kujo [--repeats N]");exit(1)};if repeats<2||repeats>20{eprint("repeats must be 2..20");exit(1)}
cold_seconds:=[];warm_seconds:=[];root:=path_join("/tmp","contentgraph-adapter-benchmark-"+uuid_v4());create_dir(root);changed_csv:=path_join(root,"content.csv");write_file(changed_csv,read_file("fixtures/adapters/content.csv")+"changed,Changed,https://example.com/changed,changed adapter row,2026-08-12\n")
last_cold:=null;last_warm:=null
for repetition in range(0,repeats){cold:=path_join(root,"cold-"+to_string(repetition));warm:=path_join(root,"warm-"+to_string(repetition));base:=["--siteprobe","fixtures/adapters/siteprobe","--sitemap","fixtures/adapters/sitemap.xml","--cms","fixtures/adapters/cms.json","--deterministic","--json"];started:=performance_now();cold_result:=spawn_process(concat(["./contentgraph","build","--csv","fixtures/adapters/content.csv","--out",cold],base),{"timeout_ms":180000,"max_output_bytes":65536});cold_seconds=push(cold_seconds,(performance_now()-started)/1000.0);if cold_result.exitcode!=0{eprint(cold_result.stderr);exit(1)};started=performance_now();warm_result:=spawn_process(concat(["./contentgraph","build","--csv",changed_csv,"--out",warm,"--incremental-from",cold],base),{"timeout_ms":180000,"max_output_bytes":65536});warm_seconds=push(warm_seconds,(performance_now()-started)/1000.0);if warm_result.exitcode!=0{eprint(warm_result.stderr);exit(1)};last_cold=parse_json(cold_result.stdout);last_warm=parse_json(warm_result.stdout)}
cleanup:=spawn_process(["find",root,"-depth","-delete"],{"timeout_ms":30000,"max_output_bytes":4096});if cleanup.exitcode!=0{eprint("cleanup failed");exit(1)}
print(to_json({"schema":"contentgraph.adapter-cache-benchmark/v1","classification":"synthetic-fixture","repeats":repeats,"cold_seconds":{"samples":cold_seconds,"median":median(cold_seconds)},"partial_warm_seconds":{"samples":warm_seconds,"median":median(warm_seconds)},"cold_cache":{"hits":last_cold["usage"]["adapter_cache_hits"],"misses":last_cold["usage"]["adapter_cache_misses"]},"partial_warm_cache":{"hits":last_warm["usage"]["adapter_cache_hits"],"misses":last_warm["usage"]["adapter_cache_misses"]}}))
