# Native end-to-end, property, differential, and adversarial ContentGraph suite.

ARTIFACTS := ["graph.json","nodes.jsonl","edges.jsonl","clusters.json","overlaps.json","orphan-candidates.json","link-opportunities.json","analysis.json","metadata.json","report.md","vector-cache.jsonl","adapter-cache.jsonl","manifest.json"]

func check_equal(actual,expected) {
    if actual!=expected { eprint("check_equal failed: actual="+to_string(actual)+" expected="+to_string(expected)); exit(1) }
}

func check_true(value) { if !value { eprint("check_true failed"); exit(1) } }
func check_false(value) { if value { eprint("check_false failed"); exit(1) } }

func run_cli(arguments, expected) {
    launcher := ["./contentgraph"]
    if env("CONTENTGRAPH_WINDOWS_LAUNCHER")=="1" { launcher=["cmd.exe","/d","/c","contentgraph.cmd"] }
    result := spawn_process(concat(launcher,arguments),{"timeout_ms":180000,"max_output_bytes":1048576})
    if result.exitcode!=expected { eprint("CLI exit mismatch: args="+to_json(arguments)+" actual="+to_string(result.exitcode)+" expected="+to_string(expected)+"\nstdout:\n"+result.stdout+"\nstderr:\n"+result.stderr);exit(1) }
    return result
}

func read_jsonl(path) {
    values:=[]
    for line in read_lines(path) { if trim(line)!="" { values=push(values,parse_json(line)) } }
    return values
}

func cleanup_run(path) {
    for name in ARTIFACTS { if path_exists(path_join(path,name)) { delete_file(path_join(path,name)) } }
    if path_exists(path) { os_rmdir(path) }
}

func cleanup_files(path,names) {
    for name in names { if path_exists(path_join(path,name)) { delete_file(path_join(path,name)) } }
    if path_exists(path) { os_rmdir(path) }
}

root := "/tmp/contentgraph-tests-"+uuid_v4()
create_dir(root)

# Golden byte compatibility and deterministic reruns.
first:=path_join(root,"first"); second:=path_join(root,"second")
run_cli(["build","--source","fixtures/source","--out",first,"--overlap-threshold","0.25","--deterministic","--json"],0)
run_cli(["build","--source","fixtures/source","--out",second,"--overlap-threshold","0.25","--deterministic","--json"],0)
for name in ARTIFACTS {
    first_hash:=sha256_file(path_join(first,name));second_hash:=sha256_file(path_join(second,name));golden_hash:=sha256_file(path_join("fixtures/golden/run",name))
    if first_hash!=second_hash { eprint("deterministic artifact mismatch: "+name+" first="+first_hash+" second="+second_hash);exit(1) }
    if first_hash!=golden_hash { eprint("golden artifact mismatch: "+name+" actual="+first_hash+" expected="+golden_hash);exit(1) }
}

# Artifact invariants and runtime contracts.
graph:=parse_json(read_file(path_join(first,"graph.json")))
nodes:=read_jsonl(path_join(first,"nodes.jsonl")); edges:=read_jsonl(path_join(first,"edges.jsonl"))
check_equal(len(graph["nodes"]),len(unique(graph["nodes"])))
check_equal(len(nodes),3)
node_map:={}; cluster_membership:={}
for node in nodes {
    check_true(regex_match(node["id"],"^CG-[a-f0-9]{20}$"))
    check_true(regex_match(node["content_fingerprint"],"^[a-f0-9]{64}$"))
    check_false(starts_with(node["source_path"],"/"))
    node_map[node["id"]]=node
    if has_key(cluster_membership,node["id"])==0 { cluster_membership[node["id"]]=0 }
    cluster_membership[node["id"]]=cluster_membership[node["id"]]+1
}
for edge in edges {
    check_true(has_key(node_map,edge["source"])==1 || starts_with(edge["source"],"query:"))
    check_true(has_key(node_map,edge["target"])==1)
    check_true(edge["weight"]>=0)
}
for node in nodes {
    for related in node["related_pages"] {
        reciprocal:=false
        for candidate in node_map[related["node_id"]]["related_pages"] { if candidate["node_id"]==node["id"] { reciprocal=true } }
        check_true(reciprocal)
    }
}
clusters:=parse_json(read_file(path_join(first,"clusters.json")))["clusters"]
seen:={}
for cluster in clusters { for id in cluster["node_ids"] { if has_key(seen,id)==0{seen[id]=0};seen[id]=seen[id]+1 } }
for id in graph["nodes"] { check_equal(seen[id],1) }
analysis:=parse_json(read_file(path_join(first,"analysis.json")))
check_true(has_key(analysis,"components")==1); check_true(has_key(analysis,"cluster_health")==1); check_true(has_key(analysis,"bridge_pages")==1)
check_equal(analysis["summary"]["component_count"],len(analysis["components"]))

# Backward compatibility: 0.1 graph runs did not contain analysis.json.
legacy:=path_join(root,"legacy");create_dir(legacy)
for name in ARTIFACTS { if name!="analysis.json" && name!="manifest.json" && name!="vector-cache.jsonl" && name!="adapter-cache.jsonl" { copy_file(path_join(first,name),path_join(legacy,name)) } }
run_cli(["orphans",legacy],0)
run_cli(["analysis",legacy],1)

# Config precedence and unknown-key rejection.
config:=path_join(root,"config.toml")
config_out:=replace_str(path_join(root,"config-run"),"\\","/")
write_file(config,"schema = \"contentgraph.config/v1\"\n[build]\nsource = [\"fixtures/source\"]\nout = \""+config_out+"\"\nmin_similarity = 0.0\ndeterministic = true\n")
run_cli(["build","--config",config,"--min-similarity","0.99","--json"],0)
check_equal(parse_json(read_file(path_join(root,"config-run/metadata.json")))["thresholds"]["minimum"],0.99)
bad_config:=path_join(root,"bad-config.toml")
write_file(bad_config,"schema = \"contentgraph.config/v1\"\n[build]\nunknown = true\n")
run_cli(["build","--config",bad_config],1)

# Adapters and GraphML query-node integrity.
adapter_run:=path_join(root,"adapters")
run_cli(["build","--siteprobe","fixtures/adapters/siteprobe","--sitemap","fixtures/adapters/sitemap.xml","--csv","fixtures/adapters/content.csv","--cms","fixtures/adapters/cms.json","--searchbridge","fixtures/adapters/searchbridge.json","--out",adapter_run,"--overlap-threshold","0.1","--deterministic","--json"],0)
adapter_metadata:=parse_json(read_file(path_join(adapter_run,"metadata.json")))
check_equal(adapter_metadata["usage"]["adapter_cache_hits"],0);check_equal(adapter_metadata["usage"]["adapter_cache_misses"],4)
graphml_result:=run_cli(["export",adapter_run,"--format","graphml"],0)
graphml:=graphml_result.stdout
check_true(contains(graphml,"search-query")>0); check_true(contains(graphml,"query:")>0); check_true(contains(graphml,"deterministic content graph")>0)

# Per-adapter partial cache reuse (SiteProbe, sitemap, CSV, CMS).
changed_csv:=path_join(root,"content-changed.csv")
write_file(changed_csv,read_file("fixtures/adapters/content.csv")+"csv-three,Changed CSV,https://example.com/csv-changed,\"changed adapter content\",2026-08-12\n")
adapter_warm:=path_join(root,"adapters-warm")
run_cli(["build","--siteprobe","fixtures/adapters/siteprobe","--sitemap","fixtures/adapters/sitemap.xml","--csv",changed_csv,"--cms","fixtures/adapters/cms.json","--searchbridge","fixtures/adapters/searchbridge.json","--out",adapter_warm,"--incremental-from",adapter_run,"--overlap-threshold","0.1","--deterministic","--json"],0)
warm_metadata:=parse_json(read_file(path_join(adapter_warm,"metadata.json")))
check_equal(warm_metadata["usage"]["adapter_cache_hits"],3);check_equal(warm_metadata["usage"]["adapter_cache_misses"],1)
tampered_cache:=path_join(root,"tampered-cache");create_dir(tampered_cache);for name in ARTIFACTS{copy_file(path_join(adapter_run,name),path_join(tampered_cache,name))};append_file(path_join(tampered_cache,"adapter-cache.jsonl"),"\n")
run_cli(["build","--siteprobe","fixtures/adapters/siteprobe","--out",path_join(root,"tampered-output"),"--incremental-from",tampered_cache,"--deterministic","--json"],1);check_false(path_exists(path_join(root,"tampered-output")))

# Stable offline CMS contract examples for five vendor export shapes.
vendor_runs:=[]
for vendor in ["wordpress","contentful","sanity","drupal","generic-sql"] {
    vendor_run:=path_join(root,"vendor-"+vendor);vendor_runs=push(vendor_runs,vendor_run)
    run_cli(["build","--cms","examples/vendor-mappings/"+vendor+".cms.json","--out",vendor_run,"--deterministic","--json"],0)
    check_equal(parse_json(read_file(path_join(vendor_run,"metadata.json")))["counts"]["nodes"],1)
}

# Deterministic, bounded explanations and SARIF policy output.
cluster_id:=parse_json(read_file(path_join(adapter_run,"clusters.json")))["clusters"][0]["id"]
cluster_explain:=parse_json(run_cli(["explain",adapter_run,"--type","cluster","--id",cluster_id,"--limit","1"],0).stdout)
check_true(cluster_explain["bounded"]);check_false(cluster_explain["automatic_mutation"]);check_true(len(cluster_explain["evidence"])<=1)
overlap_id:=parse_json(read_file(path_join(adapter_run,"overlaps.json")))["overlaps"][0]["id"]
check_equal(parse_json(run_cli(["explain",adapter_run,"--type","overlap","--id",overlap_id,"--limit","2"],0).stdout)["type"],"overlap")
link_id:=parse_json(read_file(path_join(adapter_run,"link-opportunities.json")))["opportunities"][0]["id"]
check_equal(parse_json(run_cli(["explain",adapter_run,"--type","link","--id",link_id,"--limit","2"],0).stdout)["type"],"link")
bridge_id:=parse_json(read_file(path_join(adapter_run,"analysis.json")))["bridge_pages"][0]["node_id"]
check_equal(parse_json(run_cli(["explain",adapter_run,"--type","bridge","--id",bridge_id,"--limit","2"],0).stdout)["type"],"bridge")
sarif_one:=run_cli(["export",adapter_run,"--format","sarif","--limit","2"],0).stdout
sarif_two:=run_cli(["export",adapter_run,"--format","sarif","--limit","2"],0).stdout
check_equal(sarif_one,sarif_two);sarif:=parse_json(sarif_one);check_equal(sarif["version"],"2.1.0");check_true(len(sarif["runs"][0]["results"])<=2);check_false(sarif["runs"][0]["properties"]["automaticMutation"])

# Incremental equivalence, cache invalidation, and comparison differentials.
incremental:=path_join(root,"incremental")
cache_result:=run_cli(["build","--source","fixtures/source","--out",incremental,"--incremental-from",first,"--overlap-threshold","0.25","--deterministic","--json"],0)
check_equal(parse_json(cache_result.stdout)["cache"],"hit")
for name in ARTIFACTS { check_equal(sha256_file(path_join(first,name)),sha256_file(path_join(incremental,name))) }
changed_source:=path_join(root,"changed-source"); create_dir(changed_source)
write_file(path_join(changed_source,"guide-a.md"),read_file("fixtures/source/guide-a.md")+"\nmaterial change\n")
write_file(path_join(changed_source,"guide-b.md"),read_file("fixtures/source/guide-b.md"))
write_file(path_join(changed_source,"unrelated.md"),read_file("fixtures/source/unrelated.md"))
changed:=path_join(root,"changed")
miss:=run_cli(["build","--source",changed_source,"--out",changed,"--incremental-from",first,"--overlap-threshold","0.25","--deterministic","--json"],0)
check_equal(parse_json(miss.stdout)["cache"],"miss")
check_equal(parse_json(read_file(path_join(changed,"metadata.json")))["usage"]["reused_tokenizations"],2)
comparison_result:=run_cli(["compare",first,changed],0)
comparison:=parse_json(comparison_result.stdout)
change_types:=[]; for item in comparison["changes"] { change_types=push(change_types,item["type"]) }
check_true(contains(to_json(change_types),"CONTENT_CHANGED")>0)

# Duplicate canonicals, Unicode determinism, and high-cardinality metadata.
properties:=path_join(root,"properties"); create_dir(properties)
write_file(path_join(properties,"one.md"),"---\nurl: https://example.com/duplicate\n"+join(map(range(0,200),func(i){return "meta"+to_string(i)+": value"}),"\n")+"\n---\n# Café\n\nComposed café content.")
write_file(path_join(properties,"two.md"),"---\ncanonical: https://example.com/duplicate\n---\n# Café\n\nDecomposed café content.")
property_run:=path_join(root,"property-run")
run_cli(["build","--source",properties,"--out",property_run,"--deterministic","--json"],0)
check_equal(parse_json(read_file(path_join(property_run,"metadata.json")))["counts"]["nodes"],1)
check_true(contains(read_file(path_join(property_run,"nodes.jsonl")),"Café")>0)

# Versioned mixed-script tokenizer and opt-in private local telemetry.
unicode_source:=path_join(root,"unicode-source");create_dir(unicode_source)
write_file(path_join(unicode_source,"mixed.md"),"# 多语言 Пример\n\n内容 граф multilingual")
unicode_run:=path_join(root,"unicode-run")
run_cli(["build","--source",unicode_source,"--out",unicode_run,"--tokenizer-profile","unicode-lexical/v1","--deterministic","--json"],0)
unicode_node:=read_jsonl(path_join(unicode_run,"nodes.jsonl"))[0]
check_true(contains(to_json(unicode_node["topic_signals"]),"多语言")>0);check_equal(parse_json(read_file(path_join(unicode_run,"metadata.json")))["engine"]["tokenizer_profile"],"unicode-lexical/v1")
telemetry_run:=path_join(root,"telemetry-run")
run_cli(["build","--source","fixtures/source","--out",telemetry_run,"--telemetry","--json"],0)
telemetry:=parse_json(read_file(path_join(telemetry_run,"telemetry.json")));check_false(telemetry["privacy"]["content_collected"]);check_false(telemetry["privacy"]["urls_collected"]);check_false(telemetry["privacy"]["queries_collected"]);check_false(telemetry["privacy"]["network_transmission"])
telemetry_manifest:=parse_json(read_file(path_join(telemetry_run,"manifest.json")));check_equal(telemetry_manifest["artifacts"]["telemetry.json"],sha256_file(path_join(telemetry_run,"telemetry.json")))
check_false(path_exists(path_join(first,"telemetry.json")))

# Fail-closed resource and schema behavior.
limited:=path_join(root,"limited")
run_cli(["build","--source","fixtures/source","--out",limited,"--max-output-bytes","1024"],1)
check_false(path_exists(limited))
run_cli(["build","--source",properties,"--out",path_join(root,"pair-limited"),"--max-candidate-pairs","1"],0)
dense:=path_join(root,"dense");create_dir(dense)
for i in range(0,20){write_file(path_join(dense,"page-"+to_string(i)+".md"),"---\nurl: https://example.com/dense-"+to_string(i)+"\n---\n# Shared\n\ncommon terms across every page")}
pair_failure:=path_join(root,"pair-failure")
run_cli(["build","--source",dense,"--out",pair_failure,"--max-candidate-pairs","10"],1)
check_false(path_exists(pair_failure))
corrupt:=path_join(root,"corrupt")
run_cli(["build","--source","fixtures/source","--out",corrupt,"--deterministic"],0)
write_file(path_join(corrupt,"graph.json"),"{}\n",true)
run_cli(["orphans",corrupt],1)
run_cli(["build","--source","/definitely/not/here"],1)
run_cli(["related",first,"--node","guide-a.md","--limit","0"],1)

# Input immutability.
source_hashes:={}
for name in ["guide-a.md","guide-b.md","unrelated.md"] { source_hashes[name]=sha256_file(path_join("fixtures/source",name)) }
immutability:=path_join(root,"immutability")
run_cli(["build","--source","fixtures/source","--out",immutability,"--deterministic"],0)
for name in keys(source_hashes) { check_equal(source_hashes[name],sha256_file(path_join("fixtures/source",name))) }

# Native primitive oracle.
kujo_bin:=env("CONTENTGRAPH_KUJO_BIN"); if kujo_bin==""{kujo_bin="../kujo/target/release/kujo"}
primitive:=spawn_process([kujo_bin,"run","tests/native_primitives_tests.kujo"],{"timeout_ms":30000,"max_output_bytes":65536})
check_equal(primitive.exitcode,0)

# Kujo-generated static demo stays byte-deterministic and evidence-linked.
demo_out:=path_join(root,"demo.html")
demo_build:=spawn_process([kujo_bin,"run","scripts/build-demo.kujo","--","--out",demo_out],{"timeout_ms":30000,"max_output_bytes":65536})
check_equal(demo_build.exitcode,0);check_equal(sha256_file(demo_out),sha256_file("demo/index.html"));check_true(contains(read_file(demo_out),"fixtures/golden/run/nodes.jsonl")>0);check_true(contains(read_file(demo_out),"src/engine.kujo")>0)

# Clean UUID-scoped temporary artifacts.
for path in [first,second,path_join(root,"config-run"),adapter_run,adapter_warm,incremental,changed,property_run,unicode_run,path_join(root,"pair-limited"),corrupt,immutability] { cleanup_run(path) }
for path in vendor_runs { cleanup_run(path) }
if path_exists(path_join(telemetry_run,"telemetry.json")){delete_file(path_join(telemetry_run,"telemetry.json"))};cleanup_run(telemetry_run)
legacy_artifacts:=[];for name in ARTIFACTS{if name!="analysis.json"&&name!="manifest.json"&&name!="vector-cache.jsonl"&&name!="adapter-cache.jsonl"{legacy_artifacts=push(legacy_artifacts,name)}};cleanup_files(legacy,legacy_artifacts)
cleanup_files(tampered_cache,ARTIFACTS)
cleanup_files(changed_source,["guide-a.md","guide-b.md","unrelated.md"])
cleanup_files(properties,["one.md","two.md"])
cleanup_files(unicode_source,["mixed.md"]);delete_file(changed_csv)
dense_names:=[];for i in range(0,20){dense_names=push(dense_names,"page-"+to_string(i)+".md")};cleanup_files(dense,dense_names)
delete_file(config); delete_file(bad_config)
delete_file(demo_out)
os_rmdir(root)
print("ContentGraph native validation passed.")
