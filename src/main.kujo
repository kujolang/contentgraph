# ContentGraph's Kujo entrypoint. The compatibility engine supplies deterministic
# local text parsing and sparse lexical math while those pieces are ported to Kujo.
func main() {
	command := ["python3", "src/contentgraph.py"]
	argv := args()
	i := 0
	loop {
		if i >= len(argv) { break }
		command = push(command, to_string(argv[i]))
		i := i + 1
	}
	result := spawn_process(command, {"timeout_ms": 600000})
	if result.stdout != "" { print(trim_end(result.stdout)) }
	if result.stderr != "" { print(trim_end(result.stderr)) }
	exit(result.exitcode)
}
main()
